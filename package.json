{
  "name": "opencode-ssh-session",
  "version": "0.5.0",
  "description": "OpenCode plugin for persistent SSH sessions with shell state persistence",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./tui": {
      "import": "./plugin/tui.tsx",
      "types": "./plugin/tui.tsx"
    },
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "src",
    "plugin",
    "scripts",
    "examples",
    "dist/gui-experimental.cjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --external @opencode/plugin && vite build",
    "build:gui": "vite build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write ."
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.2.5",
    "@opentui/core": ">=0.8.0",
    "@opentui/solid": ">=0.8.0",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@opencode/plugin": "2.3.0",
    "@types/bun": "^1.4.0",
    "solid-js": "^1.9.19",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-solid": "^2.11.16"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "ssh",
    "remote",
    "session"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zeyov/opencode-ssh-session"
  }
}
