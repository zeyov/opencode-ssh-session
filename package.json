{
  "name": "opencode-ssh-session",
  "version": "0.5.0",
  "description": "OpenCode plugin for persistent SSH sessions with shell state persistence",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./tui": {
      "import": "./plugin/tui.tsx",
      "types": "./plugin/tui.tsx"
    }
  },
  "files": [
    "src",
    "plugin",
    "scripts",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --external @opencode/plugin && bun build plugin/tui.tsx --outdir dist --target node --external @opencode/plugin/tui",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "bunx @biomejs/biome check .",
    "lint:fix": "bunx @biomejs/biome check --fix .",
    "format": "bunx @biomejs/biome format --write ."
  },
  "dependencies": {},
  "peerDependencies": {
    "@opencode/plugin": ">=2.2.5",
    "@opentui/core": ">=0.8.0",
    "@opentui/solid": ">=0.8.0",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/plugin": "2.2.5",
    "@types/bun": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "ssh",
    "remote",
    "session"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zeyov/opencode-ssh-session"
  }
}